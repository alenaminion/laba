#include <stdio.h>

    int akk(int N, int M) {
        if (M == 0) {
            return N + 1;
        }
        else if (M > 0 && N == 0) {
            return akk(M - 1, 1);
        }
        else {
            return akk(M - 1, akk(M, N - 1));
        }
    }

    int main() {
        int M, N;

        printf("введите М:\n");
        scanf("%d", &M);
        if (M < 0) {
            printf ("M должно быть положительным\n");
        return 1;
        }

        printf("введите N:\n");
        scanf("%d", &N);
        if (N < 0) {
            printf ("N должно быть положительным\n");
        return 1;
        }

    printf ("%d\n", akk(M, N));

return 0;
}
